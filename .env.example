# Public browser configuration. These are publishable, not secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# SERVER ONLY. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
GROQ_API_KEY=replace_with_groq_api_key
GOOGLE_AI_API_KEY=replace_with_google_ai_studio_api_key
# text-embedding-004 was shut down on 2026-01-14; keep all KB vectors on this one model.
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REST_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Generate high-entropy values locally. JWT_SECRET >= 32 chars.
# ENCRYPTION_KEY should be a random 32-byte key encoded as 64 hexadecimal characters.
JWT_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_64_hex_characters

# Optional operational settings
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Optional usage estimate inputs; set all four to current provider prices per 1M tokens.
# Leave unset to report token counts without a cost estimate.
# GROQ_INPUT_PRICE_PER_MILLION=
# GROQ_OUTPUT_PRICE_PER_MILLION=
# GOOGLE_INPUT_PRICE_PER_MILLION=
# GOOGLE_OUTPUT_PRICE_PER_MILLION=
